{
    "MultiPlotter":
        {
            "MakePlots": true, 
            "MakeConfigs": true,
            "StashConfigs": "/home/kpendleton/OldPlotMainConfigs/DCCRS2D_Donnie", //un-comment directory to stash
            //"RetreiveConfigs": "",
            "TemplateConfig": "DCCRS_RatioMain.json5", 
            //-------------Below used to create unique config file names------------//
            "MultiConfigTag": "DCCRSRatio", 
            "Tag_1": ["N", 2], // [variable tag from Level_1, position in MultiConfig name after MultiConfigTag]
            "Tag_2": ["VAR", 0],
            "Tag_3": ["TAG", 1],
            //"Tag_4": ["AUXVAR", 4],
            // Include corresponding tag for each active level
            "Levels":
                {"Level_2":
                {
                    // "VAR":  ["PLep"],
                    // "UNIT": ["GeV/c"],
                    // "TKI":  [false]
                        // comment out above/uncomment below when using variables/cuts (non-inclusive)
                    "VAR":  ["PLep", "CosLep", "q0",      "Enu_true", "q3"],
                    "UNIT": ["GeV/c","",       "GeV/c",   "GeV",      "GeV"],
                    "TKI":  [false,  true,     false,     false,      false],
                    "CUT1": [0.35,   0.56,      0.49,      0.90,      0.65],
                    "CUT2": [0.60,   0.76,      0.64,      1.20,      0.90],
                    "CUT3": [1.00,   0.92,      0.86,      1.50,      1.20],
                },
                "Level_1":
                {
                    // "N": ["Inc"], 
                    // "RANGE": ["flagCCINC"],
                    // "DISPRANGE": ["Inclusive"]
                        // comment out above/uncomment below when using ratio ranges
                    "RANGE": ["{{VAR}} < {{CUT1}}", 
                        "{{VAR}} > {{CUT1}} && {{VAR}} <= {{CUT2}}", 
                        "{{VAR}} > {{CUT2}} && {{VAR}} <= {{CUT3}}", 
                        "{{VAR}} > {{CUT3}}"],
                    "DISPRANGE": ["{{VAR}} < {{CUT1}}",
                        "{{CUT1}} < {{VAR}} <= {{CUT2}}", 
                        "{{CUT2}} < {{VAR}} <= {{CUT3}}", 
                        "{{VAR}} > {{CUT3}}"],
                    "N": ["1of4", "2of4", "3of4", "4of4"], 
                },
                "Level_3":
                {
                    "TARGET": ["Oxygen", "Carbon"],
                    "DCCFILE": ["Flat_NEUT6.1.4_OxygenDCC", "Flat_NEUT6.1.4_CarbonDCC"],
                    "RSFILE": ["Flat_NEUT6.1.4_OxygenRS", "Flat_NEUT6.1.4_CarbonRS"],
                    "TAG": ["Ox", "Carb"],
                },
                // "Level_4":
                // {
                //     // "AUXVAR" []
                // }
            }
        }  
}