    "2DRatio":
        {
            "File1":"fileonename",
            "File2":"filetwoname",
            "Cut": "variable == something",
            "Var1": "variable1",
            "Var2": "variable1",
            "AxisInfo":"XLabel, Xunits, YLabel, Yunits , Title ",
            "BinsX": [80, 0, 8], 
            "BinsY": [80, 0, 8], 
            "Name": "FileName",
            "max": 3, //individual histogram maxes when saved
            "RatioMax":3,
            "RatioMin":0,
            "logz": false,
        },
    "Contour":
        {
            "Gen":"Flat_NEUT5.9",
            "Description":"flatf_1e7",
