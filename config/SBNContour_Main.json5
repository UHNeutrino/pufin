{
    "global":
        {
            "userFolder":"/data/t2k-nova/FlatTrees",
            "treeName":"FlatTree_VARS",
            "Save": "/home/kpendleton/SavedPlots/SBNPlots/test",
            "DebugLvl":0,
            "EvisB": false,
            "KinematicsB":false,
            "TkiB": {{TKI}},
            "ThresholdsB": false,
            "DebugPrint":0,
            "DebugMode":false,
            "SavePdf":false,
            "FluxReweight":{
                "FluxPath": "/data/t2k-nova/fluxes/bnb_icarus_numu_histogram.root",
                "FluxHistogram": "hNuE_FV_ZFRONT_FULL_ERANGE",
                "AreaNormFlag":true,
                //-------------------------------------------------------------------------------------
                "XsecType":"G",
                "UndoFluxNormFlag":false,
                "TargetWeightsFile": "./config/TargetWeights.json5",
                "Detector":"Nova",
                "Target":"C12",
                "XsecMode": "total",
                "XsecPath":"/data/t2k-nova/xsec-splines/genie_xsec/v3_06_00/NULL/N2420i0211b-k250-e1000/data/xsec_graphs.root",
                "Flavor": "nu_mu",
                "NucleonsPerTarget":12
            }

        },
        "Contour":
        {
            "File":"{{FILE}}",
            "Cut": "flagCC0pi==1",
            "Var1":"q3",
            "Var2":"q0",
            "ConCuts":{ "{{VAR}} <= {{CUT1}}":"{{VAR}} <= {{CUT1}}", "{{VAR}} > {{CUT1}} && {{VAR}} <= {{CUT2}}":"{{CUT1}} < {{VAR}} <= {{CUT2}}", "{{VAR}} > {{CUT2}} && {{VAR}} <= {{CUT3}}": "{{CUT2}} < {{VAR}} <= {{CUT3}}","{{VAR}} > {{CUT3}}": " {{VAR}} > {{CUT3}}" },
            "AutoQuant":[false, "Evis_kin", "Enu_true",true,5],
            "TotalPercents":[90], //requires pdf save for line textures to show up
            "Colors":"kP6Blue, kP6Yellow, kP6Red, kP6Grape", 
            "AxisInfo":"q3, (GeV), q0, (GeV), {{NAME}} BNB 0Pi {{VAR}} Contours",
            "Bins":[50,0,2.5,40,0,2],
            "logz":true,
            "Name": "0PiContour_{{NAME}}_{{VAR}}",
        },
}