{
    "global": {
      "Save": "/Path/to/output/dir",
      "DebugMode": false,
      "DebugPrint": 0,
      "EvisB": false,
      "KinematicsB": false,
      "TkiB": false,
      "ThresholdsB": false
    },
  
    "stage2": {
      "generator": "GENIE",
      "detector": "Nova",
      "version":"5-9-0",
      "tune":"Prod7E",
  
      "filters": {
        // "interactions": ["CC", "NC"],
        "interactions": ["CC"],
        // "flavors": ["NuMu", "NuMuBar", "NuE","NuEBar"],
        "flavors": ["NuMu"],
        // "energy_ranges": ["0-8GeV", "8-30GeV", "30-120GeV"],
        "energy_ranges": ["0-8GeV"],
        "targets": ["C12", "H1", "Cl35", "O16", "Ti48"]
        // "targets": ["C12"]
      },
  
      "targets_file": "./config/TargetWeights.json5",
  
      "reWeight": {
        "enabled": true,
        "flux_inputs": {
          "NuMu": {
            /path/to/you/flux/file
            "rw_flux": "numu"
          },
          "NuMuBar": {
            /path/to/you/flux/file
            "rw_flux": "numubar"
          },
          "NuE": {
            /path/to/you/flux/file
            "rw_flux": "nue"
          },
          "NuEBar": {
            /path/to/you/flux/file
            "rw_flux": "nuebar"
          }
        },
        "xspline_mode": "G",
        "xsec_file": "/path/to/xsec/file/xsec.root",
        "xsec_mode": "auto",
        "areaB": false,
        "undoNormB": false
      },
  
      "same1D": {
        "Cut": "1",
        "Var": "Enu_true",
        "AxisInfo": "True E_{#nu}, GeV, Events, , Weighted truth prediction",
        "Bins": [160, 0.0, 8.0],
        "VBins": [false, []],
        "Name": "test100ccnumu_autoWF_v3",
        "Ext": "png",
        "Norm": false,
        "max": -1
      }
    }
  }