{
    "MultiPlotter":
        {
            "MakePlots": true, 
            "MakeConfigs": false,
            //"RetrieveConfigs": "/home/kpendleton/OldPlotMainConfigs/DCCRS2D_Donnie", //un-comment directory to retrieve
            "StashConfigs": "/home/kpendleton/OldPlotMainConfigs/DCCRS2D_Donnie",
            "TemplateConfig": "DCCRS_ContourMain.json5", 
            // Below used to create unique config file names
            "MultiConfigTag": "DCCRSContour", 
            "Tag_1": ["MODEL", 2], // [variable tag from Level_1, position in MultiConfig name after MultiConfigTag]
            "Tag_2": ["VAR", 0],
            "Tag_3": ["TAG", 1],
            //"Tag_4": ["AUXVAR", 3],
            // Include corresponding tag for each active level
            "Levels":
                {"Level_1":
                {
                    "MODEL": ["DCC", "RS"]
                },
                "Level_2":
                {
                    "VAR":  ["PLep", "CosLep", "q0",      "Enu_true", "q3"],
                    "TKI":  [false,  true,     false,     false,      false],
                    "CUT1": [0.35,   0.56,      0.49,      0.90,      0.65],
                    "CUT2": [0.60,   0.76,      0.64,      1.20,      0.90],
                    "CUT3": [1.00,   0.92,      0.86,      1.50,      1.20],
                },
                "Level_3":
                {
                    "TARGET": ["Oxygen", "Carbon"],
                    "TAG": ["Ox", "Carb"],

                },
                // "Level_4":
                // {
                //     "AUXVAR": [""]
