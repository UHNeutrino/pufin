{
    "global":
        {
            "userFolder":"/data/t2k-nova/FlatTrees",
            "treeName":"FlatTree_VARS",
            "Save": "/home/kpendleton/SavedPlots/DCCRS_RES2DPlots_Donnie",
            "DebugLvl":0,
            "EvisB": false,
            "KinematicsB":false,
            "TkiB": {{TKI}},
            "ThresholdsB": false,
            "DebugPrint":0,
            "DebugMode":false,
            "SavePdf":false,
            "FluxReweight":{
                    // "FluxPath":"/data/t2k-nova/fluxes/NOvAFluxProd6.root",
                    // "FluxHistogram":"numu",
                    "FluxPath": "/data/t2k-nova/fluxes/21bv2/run4/nd5_tuned21bv2_13anom_run4_numode_fine.root",
                    "FluxHistogram": "enu_nd5_21b_real_numu",
                    "AreaNormFlag":true,
                    //-----------------------------------------------------------------------------------//
                    // --------------------- Edit below only for re-weighting flux --------------------- //
                    //-----------------------------------------------------------------------------------//

                    "XsecType":"N", // G for Genie or N for Neut
                    "UndoFluxNormFlag":true,
                    "TargetWeightsFile": "./config/TargetWeights.json5",
                    "Detector":"T2K", // T2K or Nova
                    "Target":"C12",
                    "XsecMode": "CC", // total, CC or NC
                    "XsecPath":"/data/t2k-nova/xsec-splines/NEUT5_6_4xsecsC.root",
                    // "XsecPath":"/data/t2k-nova/xsec-splines/genie_xsec/v3_06_00/NULL/N2420i0211b-k250-e1000/data/xsec_graphs.root",
                    // "XsecPath":"/data/t2k-nova/xsec-splines/genie_xsec/v3_06_00/NULL/AR2320i00000-k250-e1000/data/xsec_graphs.root"

                    // -------- Used Only by Genie --------- //
                        
                    "Flavor": "nu_mu",
                    "NucleonsPerTarget":12
                }

        },
        "Contour":
        {
            "File":"Flat_NEUT6.1.4_{{TARGET}}{{MODEL}}",
            "Cut": "Mode == 11 || Mode == 12 || Mode == 13",
            "Var1":"W",
            "Var2":"Q2",
            "ConCuts":{ "{{VAR}} <= {{CUT1}}":"{{VAR}} <= {{CUT1}}", "{{VAR}} > {{CUT1}} && {{VAR}} <= {{CUT2}}":"{{CUT1}} < {{VAR}} <= {{CUT2}}", "{{VAR}} > {{CUT2}} && {{VAR}} <= {{CUT3}}": "{{CUT2}} < {{VAR}} <= {{CUT3}}","{{VAR}} > {{CUT3}}": " {{VAR}} > {{CUT3}}" },
            "AutoQuant":[false, "Evis_kin", "Enu_true",true,5],
            "TotalPercents":[90], //requires pdf save for line textures to show up
            "Colors":"kP6Blue, kP6Yellow, kP6Red, kP6Grape", 
            // ########## Edit axis info once MultiPlt config is made
            "AxisInfo":"W, (GeV), Q^{2}, (GeV^{2}), {{MODEL}} {{TARGET}} {{VAR}} RES Contours",
            "Bins":[50,0.5,3,60,0,3],
            "logz":true,
            "Name": "DCCRSContour_{{VAR}}_{{TAG}}_{{MODEL}}",
        },
}