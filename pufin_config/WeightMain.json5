{
  "save": "/Path/to/output/dir",
  "generator": "GENIE",
  "detector": "Nova",
  "version":"5-9-0",
  "tune":"Prod7E",

  "filters": {
    "interaction": ["CC", "NC"],
    // "interaction": ["CC"],
    "flavor": ["NuMu", "NuMuBar", "NuE","NuEBar"],
    // "flavor": ["NuMu"],
    "e_range": ["0-8GeV", "8-30GeV", "30-120GeV"],
    // "e_range": ["0-8GeV"],
    "target": ["C12", "H1", "Cl35", "O16", "Ti48"]
    // "target": ["C12"]
  },

  "targets_file": "./pufin_config/TargetWeights.json5",

  "reweight": {
    "enabled": true,
    "flux_inputs": {
      "NuMu": {
        "rw_file": "/path/to/you/flux/file",
        "rw_flux": "numu"
      },
      "NuMuBar": {
        "rw_file": "/path/to/you/flux/file",
        "rw_flux": "numubar"
      },
      "NuE": {
        "rw_file": "/path/to/you/flux/file",
        "rw_flux": "nue"
      },
      "NuEBar": {
        "rw_file": "/path/to/you/flux/file",
        "rw_flux": "nuebar"
      }
    },
    "xsec_file": "/path/to/xsec/file/xsec.root",
    "areaB": false,
    "undoNormB": false
  },
  "saveDF":"/dir/to/saved/dataframe/Name.root",
  "saveEnu":"/dir/to/saved/enu/spec/Name.root"
}